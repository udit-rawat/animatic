# ── LLM Provider (priority: Gemini > OpenRouter > Anthropic SDK > Claude CLI) ─

# Option 1: Gemini API — free tier, 20 req/day per key
# Multiple keys rotate automatically when one is exhausted (4 keys = 80 RPD)
GEMINI_API_KEYS=key1,key2,key3,key4
# Single key (legacy, still works):
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.0-flash   # default, override if needed

# Option 2: OpenRouter — free models, per-stage routing
OPENROUTER_API_KEY=your_openrouter_key_here
# Per-stage models (each picked for its strength):
OPENROUTER_MODEL_RANKER=deepseek/deepseek-r1:free
OPENROUTER_MODEL_SCRIPTER=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL_ANIMATOR=deepseek/deepseek-r1:free
# Optional: override all stages with one model (benchmark mode)
# OPENROUTER_MODEL=deepseek/deepseek-r1:free

# Option 2: Anthropic SDK (GitHub Actions / CI)
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Option 3: Claude CLI (default — run inside a Claude Code session, no key needed)
# Nothing to set. Just run: python run.py

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Scraper ──────────────────────────────────────────────────────────────────
SUBREDDITS=r/MachineLearning,r/LocalLLaMA,r/deeplearning,r/mlops,r/StableDiffusion,r/Transformers,r/computervision
