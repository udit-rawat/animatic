# ── LLM Provider ─────────────────────────────────────────────────────────────

# Active path: Gemini.
# Multiple keys rotate automatically when one is exhausted.
GEMINI_API_KEYS=key1,key2,key3,key4
# Single key still works:
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional fallback: OpenRouter
OPENROUTER_API_KEY=your_openrouter_key_here
# Optional override:
# OPENROUTER_MODEL=deepseek/deepseek-r1:free

# Optional fallback: Anthropic SDK
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Claude CLI / handoff mode needs no extra env vars.

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── TTS ──────────────────────────────────────────────────────────────────────
# The spec's "tts_model" and "voice" win; these are fallbacks.
# TTS_MODEL=gemini-3.1-flash-tts-preview
# TTS_VOICE=Sulafat

# ── Renderer ─────────────────────────────────────────────────────────────────
# HyperFrames runs through npx (pinned in scripts/render_hyperframes.py); needs Node 18+ and ffmpeg.
# The legacy Remotion renderer needs: cd remotion && npm install
